{
    "manifest_version": 3,
    "name": "AI-Free Search",
    "version": "1.0",
    "description": "Google検索の AI要約とAIモードタブを非表示にします。",
    "permissions": ["scripting"],
    "host_permissions": ["https://www.google.com/*"],
    "content_scripts": [
      {
        "matches": ["https://www.google.com/search*"],
        "js": ["content.js"],
        "run_at": "document_idle"
      }
    ],
    "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}